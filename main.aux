\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Overview of the ANoT architecture. \textbf  {Phase 1 (Planning)} transforms user requests into validated executable scripts, cached across items. \textbf  {Phase 2 (Adaptation)} detects content heterogeneity and potential attacks before execution. \textbf  {Phase 3 (Execution)} processes each evidence source independently via split-context LLM calls, then aggregates results using three-valued logic ($+1$: satisfied, $0$: unknown, $-1$: violated).}}{3}{figure.caption.4}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{fig:architecture}{{1}{3}{Overview of the ANoT architecture. \textbf {Phase 1 (Planning)} transforms user requests into validated executable scripts, cached across items. \textbf {Phase 2 (Adaptation)} detects content heterogeneity and potential attacks before execution. \textbf {Phase 3 (Execution)} processes each evidence source independently via split-context LLM calls, then aggregates results using three-valued logic ($+1$: satisfied, $0$: unknown, $-1$: violated)}{figure.caption.4}{}}
